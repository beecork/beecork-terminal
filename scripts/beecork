#!/usr/bin/env python3
"""beecork — talk to a running Beecork Terminal from the shell.

Exists so a CLI agent running INSIDE a session can ask the app to open another
one: a `/lead` staffing its own crew, rather than the user opening N tabs by
hand and typing `/member` in each.

The app validates every request at the socket (see src-tauri/src/control.rs).
This script deliberately does no validation of its own — a client-side check
would be security theatre, since anything can write to the socket.

  beecork ping
  beecork new [--cwd DIR] [--run /member]
"""
import argparse
import json
import os
import socket
import sys

APP_ID = "com.beecork.terminal"


def socket_path() -> str:
    """Mirror `control::socket_path` — the app's per-user data dir."""
    if sys.platform == "darwin":
        base = os.path.expanduser("~/Library/Application Support")
    else:
        base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, APP_ID, "control.sock")


def send(req: dict) -> dict:
    path = socket_path()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(path)
    except (FileNotFoundError, ConnectionRefusedError):
        # The most common failure by far, and the message has to say what to do
        # about it rather than print a stack trace at an agent.
        raise SystemExit(
            f"Beecork Terminal is not running, or is too old for the control socket.\n"
            f"  looked for: {path}"
        )
    except OSError as e:
        raise SystemExit(f"could not reach Beecork Terminal: {e}")
    with s:
        s.sendall((json.dumps(req) + "\n").encode())
        line = s.makefile("r", encoding="utf-8").readline()
    if not line:
        raise SystemExit("Beecork Terminal closed the connection without answering")
    return json.loads(line)


def main() -> int:
    ap = argparse.ArgumentParser(prog="beecork", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("ping", help="is the app running, and what version")
    new = sub.add_parser("new", help="open a session")
    new.add_argument("--cwd", help="absolute path the shell starts in")
    new.add_argument("--run", help="a slash command to run once the shell is ready")

    a = ap.parse_args()
    if a.cmd == "ping":
        r = send({"cmd": "ping"})
        if r.get("ok"):
            print(f"Beecork Terminal {r.get('version', '?')} is running")
            return 0
    else:
        cwd = os.path.abspath(a.cwd) if a.cwd else None
        r = send({"cmd": "session.new", "cwd": cwd, "run": a.run})
        if r.get("ok"):
            where = cwd or "the default folder"
            print(f"opened a session in {where}" + (f", running {a.run}" if a.run else ""))
            return 0
    print(f"beecork: {r.get('error', 'request refused')}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
